{
  "api_version": "saiops/v1",
  "kind": "ServiceObservability",
  "metadata": {
    "name": "checkout-api",
    "owner": "commerce-sre@sai-lab.local",
    "environment": "production",
    "cloud": "multi-cloud"
  },
  "spec": {
    "metrics": {
      "request_rate": "sum(rate(http_server_requests_total{service=\"checkout-api\"}[5m]))",
      "error_rate": "sum(rate(http_server_requests_total{service=\"checkout-api\",status_code=~\"5..\"}[5m])) / sum(rate(http_server_requests_total{service=\"checkout-api\"}[5m]))",
      "latency_p95": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_milliseconds_bucket{service=\"checkout-api\"}[5m])))",
      "cpu_utilization": "sum(rate(container_cpu_usage_seconds_total{service=\"checkout-api\"}[5m]))"
    },
    "slo": {
      "availability_target": 0.999,
      "latency_p95_ms": 500
    },
    "alerts": {
      "warning_burn_rate": 2,
      "critical_burn_rate": 14
    },
    "runbook_url": "https://github.com/justinmail735-eng/Sai-SRE-AI_lab/tree/main/reliability/runbooks/checkout-api.md"
  }
}
